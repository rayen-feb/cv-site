---

interface Project {
  title: string;
  image: string;
  link: string;
  preview: string;
  status: string;
  description: string;
}

const projects: Project[] = [
  {
    title: "Student Performance Prediction",
    image:
      "https://blog.kinems.com/content/images/2018/04/Tracking_Headline.png",
    link: "https://github.com/rayen-feb/student-performance-ml",
    preview: "https://rayen-feb.github.io/student-performance-ml/",
    status: "Published",
    description:
      "ML system that predicts academic outcomes using ensemble regression and engineered features from student data.",
  },
  {
    title: "Soil Fertilization",
    image:
      "https://images.unsplash.com/photo-1773332611522-06b86b48cbf1?q=80&w=1170&auto=format&fit=crop",
    link: "https://github.com/rayen-feb/soil-fertility-dashboard-",
    preview: "https://rayen-feb.github.io/soil-fertility-dashboard-/",
    status: "Deployed",
    description:
      "An end-to-end agricultural analytics project combining EDA, feature engineering, and Random Forest modeling to recommend fertilizer strategies.",
  },
  {
    title: "FactuScan SaaS OCR",
    image:
      "https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop",
    link: "https://github.com/rayen-feb/soil-fertility-dashboard-",
    preview: "https://factuscanner-tn.onrender.com/",
    status: "In Development",
    description:
      "A full-stack OCR and document intelligence platform that transforms invoices into structured, query-ready business data.",
  },
  {
    title: "Cancer Detection",
    image:
      "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop",
    link: "https://github.com/rayen-feb/machine_learning_breast_cancer_detection",
    preview: "#!",
    status: "Research",
    description:
      "Deep learning medical image classification pipeline focused on early detection using CNN-based learning and normalization strategies.",
  },
  {
    title: "Tour de France ML",
    image:
      "https://cisp.cachefly.net/assets/articles/images/resized/0001010788_resized_mediawall1022.jpg",
    link: "https://github.com/rayen-feb/Data-Analysis-Dashboard-tour-de-france-/blob/8d0d7b466f81df4a0b642208e0563125c0abbf6c/README.md",
    preview: "#!",
    status: "Analytics",
    description:
      "Predictive sports analytics project using rider performance, weather, and stage features to model race outcomes and fatigue.",
  },
  {
    title: "Tunisian Sign Language Recognition",
    image:
      "https://images.unsplash.com/photo-1551240903-154be3f2e18b?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    link: "https://github.com/rayen-feb/Tunisian-Sign-Language-recognition",
    preview: "#!",
    status: "AI Demo",
    description:
      "A deep-learning recognition system for Tunisian sign gestures, combining MediaPipe preprocessing and a MobileNetV2 model.",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center gap-3 mb-3">
      <span class="text-[var(--sec)] text-xs font-medium uppercase tracking-[0.2em]">Featured work</span>
      <span class="h-px flex-1 bg-gradient-to-r from-[var(--sec)]/60 to-transparent"></span>
    </div>
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group project-card">
            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="project-visual rounded-2xl overflow-hidden shadow-lg transition-all duration-300 mb-4">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-72 object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="flex items-start px-3 pt-1">
                <div class="flex-grow">
                  <div class="project-heading">
                    <h4 class="text-2xl font-semibold">{project.title}</h4>
                    <span class="project-status">{project.status}</span>
                  </div>
                  <p class="mt-2 text-[var(--white-icon)] text-sm leading-relaxed">
                    {project.description}
                  </p>
                </div>
                <div class="flex gap-2 ml-4 mt-1">
                  <a
                    target="_blank"
                    href={project.link}
                    aria-label="GitHub"
                    class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  <a
                    target="_blank"
                    href={project.preview}
                    aria-label="Preview"
                    class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://github.com/rayen-feb"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
  <style is:global>
    .project-card {
      transform: translateY(0);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .project-card:hover {
      transform: translateY(-5px);
    }

    .project-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.25rem;
    }

    .project-status {
      display: inline-flex;
      align-items: center;
      padding: 0.3rem 0.6rem;
      border-radius: 999px;
      background: rgba(164, 118, 255, 0.12);
      border: 1px solid rgba(164, 118, 255, 0.24);
      color: var(--white);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .project-visual {
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 30px 45px rgba(0, 0, 0, 0.18);
    }

    .project-card:hover .project-visual {
      box-shadow: 0 30px 50px rgba(164, 118, 255, 0.12);
    }
  </style>
</section>
